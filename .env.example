# IRCTC User Credentials (optional, for automated login input)
IRCTC_USERNAME=your_username
IRCTC_PASSWORD=your_password

# Journey details (for automatic filling)
# Use standard station codes, e.g., NDLS for New Delhi, MAS for Chennai, HWH for Howrah, etc.
FROM_STATION=NDLS
TO_STATION=CSMT
JOURNEY_DATE=20/08/2026

# Ticket Class (e.g., 3A, 2A, 1A, SL, CC, 2S, etc.)
# If left empty, the search will default to "All Classes"
TICKET_CLASS=3A

# Quota (e.g., GENERAL, TATKAL, LADIES, SENIOR CITIZEN)
TICKET_QUOTA=GENERAL
